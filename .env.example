# =====================================================
# Nutrify environment variables
# Copy to .env and fill in real values. .env is gitignored.
# =====================================================

# --- Supabase ---
# Get from: https://app.supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Azure OpenAI ---
# (Server-side only — used in Supabase Edge Functions, NEVER shipped to mobile client)
# Get from: Azure Portal → your OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key

# Default API version — used unless a per-deployment override below is set
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Per-deployment API version overrides (leave blank to use the default above).
# Some models (notably GPT-5) require a newer preview api-version than GPT-4o.
AZURE_OPENAI_API_VERSION_VISION=
AZURE_OPENAI_API_VERSION_COACH=
AZURE_OPENAI_API_VERSION_QUICK=

# Deployment names (you set these when you deploy a model in Azure AI Studio).
# These are the deployment names you gave each model — NOT the model name itself.
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4o
AZURE_OPENAI_DEPLOYMENT_COACH=gpt-5
AZURE_OPENAI_DEPLOYMENT_QUICK=gpt-4o

# --- App ---
EXPO_PUBLIC_APP_ENV=development
